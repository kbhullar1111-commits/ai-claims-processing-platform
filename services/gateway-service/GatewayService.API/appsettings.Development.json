{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
    "ReverseProxy": {
    "Routes": {
      "claims-route": {
        "ClusterId": "claims-cluster",
        "Match": {
          "Path": "/api/claims/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "documents-route": {
        "ClusterId": "documents-cluster",
        "Match": {
          "Path": "/api/documents/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      }
    },
    "Clusters": {
      "claims-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7213/"
          }
        }
      },
      "documents-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7265/"
          }
        }
      }
    }
  }
}
