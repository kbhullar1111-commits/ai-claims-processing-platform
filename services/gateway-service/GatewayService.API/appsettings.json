{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "TenantId": "e0069181-d458-40eb-8ed0-a4ce9c289c77",
    "ApiClientId": "6d25e7d5-1cf3-4100-89d5-b4616d93c41e",
    "SwaggerClientId": "1879a97f-118f-46ac-b7a7-8e147f27b0e3"
  },
  "KeyVault": {
    "Url": "https://kv-aiclaims-dev.vault.azure.net/"
  },
  "Observability": {
    "Tracing": {
      "SampleRatio": 1.0
    }
  },
  "ReverseProxy": {
    "Routes": {
      "claims-route": {
        "ClusterId": "claims-cluster",
        "Match": {
          "Path": "/api/claims/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "documents-route": {
        "ClusterId": "documents-cluster",
        "Match": {
          "Path": "/api/documents/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      }
    },
    "Clusters": {
      "claims-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://claims-service/"
          }
        }
      },
      "documents-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://document-service/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
