{
  "KeyVault": {
    "Url": "https://kv-aiclaims-dev.vault.azure.net/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Observability": {
    "Tracing": {
      "SampleRatio": 1.0
    }
  },
  "Messaging": {
    "FraudServiceQueue": "fraud-service",
    "FraudCheckCompletedTopic": "fraud-check-completed",
    "MaxConcurrentCalls": 8,
    "PrefetchCount": 32,
    "MaxAutoLockRenewalMinutes": 5,
    "HandlerRetryMaxAttempts": 3,
    "HandlerRetryBaseDelayMs": 200,
    "HandlerRetryMaxDelaySeconds": 5,
    "MaxDeliveryAttemptsBeforeDeadLetter": 10
  },
  "ServiceBus": {
    "FullyQualifiedNamespace": "sb-aiclaims-dev-kamal01.servicebus.windows.net"
  },
  "AllowedHosts": "*"
}
