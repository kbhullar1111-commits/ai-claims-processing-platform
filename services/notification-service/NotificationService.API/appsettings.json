{
  "KeyVault": {
    "Url": "https://kv-aiclaims-dev.vault.azure.net/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Observability": {
    "Tracing": {
      "SampleRatio": 1.0
    }
  },
  "NotificationDispatcher": {
    "PollIntervalSeconds": 10,
    "RetryDelayMinutes": 5,
    "MaxRetryAttempts": 5
  },
  "Messaging": {
    "Queues": {
      "NotificationServiceQueue": "notification-service"
    },
    "Topics": {
      "ClaimSubmittedTopic": "claim-submitted"
    },
    "Subscriptions": {
      "ClaimSubmittedSubscription": "notification-service"
    },
    "MaxConcurrentCalls": 8,
    "PrefetchCount": 32,
    "MaxAutoLockRenewalMinutes": 5,
    "HandlerRetryMaxAttempts": 3,
    "HandlerRetryBaseDelayMs": 200,
    "HandlerRetryMaxDelaySeconds": 5,
    "MaxDeliveryAttemptsBeforeDeadLetter": 10
  },
  "AllowedHosts": "*"
}
