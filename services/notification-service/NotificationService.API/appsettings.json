{
  "KeyVault": {
    "Url": "https://kv-aiclaims-dev.vault.azure.net/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Observability": {
    "Tracing": {
      "SampleRatio": 1.0
    }
  },
  "NotificationDispatcher": {
    "PollIntervalSeconds": 10,
    "RetryDelayMinutes": 5,
    "MaxRetryAttempts": 5
  },
  "Messaging": {
    "Queues": {
      "NotificationServiceQueue": "notification-service"
    }
  },
  "AllowedHosts": "*"
}
