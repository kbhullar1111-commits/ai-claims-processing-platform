### =====================
### Customer Service
### =====================

### Create Customer
# @name createCustomer
POST {{customerApi}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "firstName": "John",
  "lastName": "Doe",
  "dateOfBirth": "1992-05-15",
  "email": "john.doe@example.com",
  "phone": "+919876543210",
  "addressLine1": "123 Main Street",
  "addressLine2": "Apartment 201",
  "city": "Bengaluru",
  "state": "Karnataka",
  "postalCode": "560001",
  "country": "India",
  "preferredCommunication": "Email"
}

###

# @customerId={{createCustomer.response.body.$.customerId}}
@customerId=3123-1-31s-d23-d2-d
@email=Kamal.Singh1129@outlook.com

### Get All Customers

GET {{customerApi}}
Accept: application/json
Authorization: Bearer {{token}}

###

### Get Customer

GET {{customerApi}}/{{customerId}}
Accept: application/json
Authorization: Bearer {{token}}

###

### Get Customer by Email

GET {{customerApi}}/by-email/{{email}}
Accept: application/json
Authorization: Bearer {{token}}

###

### Update Customer

PUT {{customerApi}}/{{customerId}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "firstName": "John",
  "lastName": "Smith",
  "email": "john.smith@example.com",
  "phone": "+919800000001",
  "addressLine1": "101 MG Road",
  "addressLine2": "",
  "city": "Bengaluru",
  "state": "Karnataka",
  "postalCode": "560001",
  "country": "India",
  "preferredCommunication": "Email",
  "status": "Active",
}

